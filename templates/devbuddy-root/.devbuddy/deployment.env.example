# Copy to deployment.env and fill in. deployment.env holds a credential: keep this whole root out
# of OneDrive, Dropbox, and any other sync, and do not commit it anywhere.
#
# The label. Must match "deployment" in project.json. It exists so a project.json copied here from
# another company's root is refused loudly instead of resolving against the wrong token.
DEVBUDDY_DEPLOYMENT=acme-prod

# The MCP server connects to PostgreSQL directly. It is a host over the shared core, not a client
# of the HTTP API. The shape, filled in beside it rather than here, because this file is committed:
#
#   Host=localhost;Port=5432;Database=devbuddy;Username=devbuddy;Password=...
DEVBUDDY_CONNECTION_STRING=

# Must match the deployment. Shared with the API so one identity works across both.
DEVBUDDY_SIGNING_KEY=

# Your machine token. Mint one under Plugin access in the web interface. It is shown once, it
# carries exactly your own permissions, and revoking it takes effect on the next call.
DEVBUDDY_TOKEN=

# Full path to DevBuddy.McpServer.dll. DEVBUDDY_MCP_COMMAND defaults to dotnet and is only needed
# for a self-contained publish.
DEVBUDDY_MCP_ASSEMBLY=C:\tools\devbuddy\DevBuddy.McpServer.dll

# DEVBUDDY_ANALYSIS_ROOT_PATH is deliberately absent. enter.ps1 computes it from this directory, so
# it cannot drift out of step with the junctions setup.ps1 creates.
