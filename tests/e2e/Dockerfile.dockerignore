# The e2e image is built from the repository root, and needs two things from it: this directory
# and the client generated for web/admin. Everything else stays out of the context.
*
!tests/e2e/
!web/admin/src/api/operations.ts
!src/clients/devbuddy-npx/package.json
!src/clients/devbuddy-npx/bun.lock
!src/clients/devbuddy-npx/tsconfig.json
!src/clients/devbuddy-npx/src/

tests/e2e/node_modules/
tests/e2e/.out/
tests/e2e/.state/
tests/e2e/test-results/
tests/e2e/playwright-report/
