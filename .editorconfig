root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md,ts,tsx,js,jsx,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets}]
indent_size = 2

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Expression preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion

# Nullability and immutability
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion

# Naming: interfaces prefixed with I
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

# Naming: private constants and static readonly fields are PascalCase.
# Declared before the _camelCase rule below, because the first matching rule wins.
dotnet_naming_rule.private_constants_are_pascal_case.symbols = private_const_symbol
dotnet_naming_rule.private_constants_are_pascal_case.style = pascal_case_style
dotnet_naming_rule.private_constants_are_pascal_case.severity = warning
dotnet_naming_symbols.private_const_symbol.applicable_kinds = field
dotnet_naming_symbols.private_const_symbol.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_const_symbol.required_modifiers = const

dotnet_naming_rule.private_static_readonly_are_pascal_case.symbols = private_static_readonly_symbol
dotnet_naming_rule.private_static_readonly_are_pascal_case.style = pascal_case_style
dotnet_naming_rule.private_static_readonly_are_pascal_case.severity = warning
dotnet_naming_symbols.private_static_readonly_symbol.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_symbol.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_static_readonly_symbol.required_modifiers = static, readonly

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Naming: private instance fields _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case
