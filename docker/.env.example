# Copy to docker/.env and fill in. That file is refused by .gitignore, and nothing here is baked
# into an image: every value arrives as an environment variable at run time (SB-32).
#
# Generate the two long ones with something that is actually random, for example:
#   openssl rand -base64 48

# PostgreSQL. Reachable only on the internal network; no host port is published.
DEVBUDDY_DB_PASSWORD=

# Signs access tokens. Shared by the API and the MCP server so one identity works across both.
# At least 32 characters, and refused rather than padded if it is shorter.
DEVBUDDY_SIGNING_KEY=

# MinIO. Also reachable only on the internal network.
DEVBUDDY_EVIDENCE_ACCESS_KEY=
DEVBUDDY_EVIDENCE_SECRET_KEY=

# Where analysis reads working copies from: one directory per project, named by project
# identifier. Mounted read-only into both servers.
DEVBUDDY_PROJECTS_PATH=./projects

# SMTP, for delivering account setup and password recovery tokens. Optional, and what happens
# when it is left empty is the thing to decide rather than to skip: the provider stays "Log",
# which writes those tokens into the API container's log for an operator to carry by hand. That
# is a working delivery channel for a single-operator installation and a secret sitting in a log
# for any other. See docs/operations/logging.md.
#
# To deliver for real: set the provider to Smtp and fill in the host below.
DEVBUDDY_EMAIL_PROVIDER=Log
DEVBUDDY_SMTP_HOST=
DEVBUDDY_SMTP_PORT=587
DEVBUDDY_SMTP_USERNAME=
DEVBUDDY_SMTP_PASSWORD=
DEVBUDDY_SMTP_START_TLS=true
DEVBUDDY_SMTP_FROM=devbuddy@example.com

# Observability, only needed when running with docker/compose.observability.yaml. Grafana is
# published on loopback and this is its administrator password, so it is not optional there.
DEVBUDDY_GRAFANA_PASSWORD=

# Whether application logs are shipped to Loki along with traces and metrics. Left false on
# purpose: with the email provider still on Log, setup and recovery tokens are written to the log
# deliberately, and turning this on would copy them into a system more people can read. Configure
# SMTP above first. See docs/operations/logging.md.
DEVBUDDY_TELEMETRY_EXPORT_LOGS=false
