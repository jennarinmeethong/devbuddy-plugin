# Copy to docker/.env and fill in. That file is refused by .gitignore, and nothing here is baked
# into an image: every value arrives as an environment variable at run time (SB-32).
#
# Generate the two long ones with something that is actually random, for example:
#   openssl rand -base64 48

# PostgreSQL. Reachable only on the internal network; no host port is published.
DEVBUDDY_DB_PASSWORD=

# Signs access tokens. Shared by the API and the MCP server so one identity works across both.
# At least 32 characters, and refused rather than padded if it is shorter.
DEVBUDDY_SIGNING_KEY=

# MinIO. Also reachable only on the internal network.
DEVBUDDY_EVIDENCE_ACCESS_KEY=
DEVBUDDY_EVIDENCE_SECRET_KEY=

# The key MinIO encrypts stored objects with. Not optional: the application asks for server-side
# encryption on every artefact, and MinIO refuses the write outright if it has no key to use, so
# an installation without this cannot store evidence at all.
#
# The format is a name, a colon, and 32 random bytes in base64:
#   echo "devbuddy-key:$(openssl rand -base64 32)"
DEVBUDDY_EVIDENCE_KMS_KEY=

# Where analysis reads working copies from: one directory per project, named by project
# identifier. Mounted read-only into both servers.
DEVBUDDY_PROJECTS_PATH=./projects

# SMTP, for delivering account setup and password recovery tokens. Optional: left empty the
# provider stays "Log", which no longer means the token is written to a log. It means the API
# records that a message could not be delivered, to whom, and how to fix that, and writes the
# token nowhere — see the next block. A setup token is also returned in the create_user_account
# response, so inviting somebody works with no mail server at all; self-service password recovery
# does not work until either this block or the next one is set.
#
# To deliver for real: set the provider to Smtp and fill in the host below. The provider is not
# inferred from the host being set — both lines are read.
DEVBUDDY_EMAIL_PROVIDER=Log
DEVBUDDY_SMTP_HOST=
DEVBUDDY_SMTP_PORT=587
DEVBUDDY_SMTP_USERNAME=
DEVBUDDY_SMTP_PASSWORD=
DEVBUDDY_SMTP_START_TLS=true
DEVBUDDY_SMTP_FROM=devbuddy@example.com

# The other way out, and a decision rather than a convenience: true writes one-time setup and
# recovery tokens into the application log, for an operator to read and carry by hand. v1 did
# this unconditionally and docs/security/release-readiness.md carried it as an accepted risk;
# since Phase 12B nothing does it unless this line says so. A retention window is not a control
# over who can read a file while it exists, so setting this accepts that anything able to read
# the log volume — or a log aggregator the logs are shipped to — can use the tokens in it.
DEVBUDDY_EMAIL_ALLOW_TOKENS_IN_LOG=false

# How often the stack applies the retention schedule. The `retention` service runs the same sweep
# as `dotnet run -- retention`, in the same image, for as long as the stack is up; through v1 that
# sweep was documented and tested and ran only if an operator built something to run it.
#
# Daily is enough: every window in the schedule is measured in days or years. A minute is the
# shortest value accepted, and a pass reads every audit, backup, export and log row, so shorter
# buys nothing.
DEVBUDDY_RETENTION_EVERY=24h

# Application log files. The stack writes them into a named volume and `dotnet run -- retention`
# deletes the ones past the window, which is what makes the ninety days the retention schedule
# names a tested behaviour rather than a log-driver size somebody guessed. Clear the path to go
# back to standard output only. See docs/operations/logging.md.
DEVBUDDY_LOG_PATH=/srv/logs/devbuddy.log
DEVBUDDY_LOG_RETENTION_DAYS=90

# Observability, only needed when running with docker/compose.observability.yaml. Grafana is
# published on loopback and this is its administrator password, so it is not optional there.
DEVBUDDY_GRAFANA_PASSWORD=

# Whether application logs are shipped to Loki along with traces and metrics. This is option 2 in
# docs/operations/logging.md and it is the option in force for this deployment (info.md,
# 2026-09-10), so it is on here rather than off: Loki's ninety days is the retention of record for
# application logs, and the file sink stays as the local copy with its own sweep.
#
# What used to keep this false was that setup and recovery tokens were written into those logs by
# design, and shipping them to a system more people can read copied single-use credentials into
# it. That is now off by default (DEVBUDDY_EMAIL_ALLOW_TOKENS_IN_LOG above). If you turn that on,
# turn this back off or accept that the tokens travel with the logs.
DEVBUDDY_TELEMETRY_EXPORT_LOGS=true
