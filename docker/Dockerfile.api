# The HTTP API.
#
# Chiseled base: no shell, no package manager, no busybox. If something gets code execution inside
# this container there is nothing in it to execute. That is also why the build stage is separate —
# the SDK never ships.
#
# Built from the repository root:
#   docker build -f docker/Dockerfile.api -t devbuddy-api .

# Multi-platform, and cross-compiled rather than emulated. `--platform=$BUILDPLATFORM` pins the SDK
# stage to the machine doing the building, and `-a $TARGETARCH` tells .NET what to produce, so a
# linux/arm64 image is compiled at native speed on an amd64 runner instead of running the whole
# compiler under QEMU. Only the runtime stage is the target architecture, and nothing executes
# there — it is a file copy.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /src

# Restore before the source is copied, so a source change does not re-download the world.
COPY global.json Directory.Build.props Directory.Packages.props DevBuddy.slnx ./
COPY src/ src/
COPY tests/ tests/
RUN dotnet restore src/hosts/DevBuddy.Api/DevBuddy.Api.csproj -a $TARGETARCH

RUN dotnet publish src/hosts/DevBuddy.Api/DevBuddy.Api.csproj \
    -c Release \
    -a $TARGETARCH \
    -o /app \
    --no-restore \
    /p:UseAppHost=false

# Empty directories to copy into the runtime image, so every mount point exists and belongs to the
# application user before a volume is attached to it. A chiseled image has no shell, so there is no
# RUN mkdir over there — and this has to happen in the image rather than at run time, because
# Docker seeds a fresh named volume from the mount point's contents and ownership. Without it the
# volume arrives owned by root and the first write fails with "permission denied", which is how the
# backup volume failed the first time the stack ran.
RUN mkdir -p /seed/empty

# The administration UI ships inside this image, so the API and the client generated from it are
# one origin and one deployment. Bun rather than npm, because that is what builds this client
# everywhere else; `bun run build` type-checks first, so a type error fails the image build.
# On the builder's own architecture too: this stage emits static files, which have no
# architecture, so running Bun under emulation for an arm64 image would cost minutes and change
# nothing about the output.
FROM --platform=$BUILDPLATFORM oven/bun:1 AS web
WORKDIR /web

# The manifest first, so a source change does not reinstall the world.
COPY web/admin/package.json web/admin/bun.lock ./
RUN bun install --frozen-lockfile

COPY web/admin/ ./
RUN bun run build

# Chiseled, non-root by construction: the image ships with an "app" user and runs as it.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled AS runtime
WORKDIR /app
COPY --from=build /app .
COPY --from=build --chown=$APP_UID:$APP_UID /seed/empty /srv/backups
COPY --from=build --chown=$APP_UID:$APP_UID /seed/empty /srv/exports
COPY --from=build --chown=$APP_UID:$APP_UID /seed/empty /srv/logs

# Static files, served only because they are here: with no wwwroot the application skips that whole
# branch, which is what running from source does.
COPY --from=web --chown=$APP_UID:$APP_UID /web/dist ./wwwroot

# Stated rather than inherited. A base image that changed its default would otherwise change ours.
USER $APP_UID

ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_gcServer=1

EXPOSE 8080

ENTRYPOINT ["dotnet", "DevBuddy.Api.dll"]
