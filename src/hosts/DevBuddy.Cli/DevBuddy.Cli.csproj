<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console host: migrate, seed, health, export, backup/restore, sync, reindex. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\DevBuddy.Application\DevBuddy.Application.csproj" />
    <ProjectReference Include="..\..\core\DevBuddy.Infrastructure\DevBuddy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The command surface is internal: the console's public shape is its command line, not a
         type. The tests reach in to parse through the same configuration the console uses. -->
    <InternalsVisibleTo Include="DevBuddy.Application.Tests" />
  </ItemGroup>

</Project>
